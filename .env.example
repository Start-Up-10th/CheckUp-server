# Database
DB_URL=jdbc:postgresql://postgres:5432/checkup
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# DataGSM OAuth
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
DATAGSM_REDIRECT_URI=

# DataGSM 학생 OpenAPI (학생 조회·수동 동기화·봉사 명단). DataGSM 콘솔에서 STUDENT_READ 권한으로 발급. 비어 있으면 서버가 시작하지 않는다.
DATAGSM_API_KEY=

# DataGSM 웹훅 (이벤트 등록 시 한 번만 발급)
DATAGSM_WEBHOOK_SECRET=

# 학생 웹 주소 (QR 링크에 사용)
PUBLIC_ORIGIN=

# 세션
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=

# API 문서
SWAGGER_ENABLED=true