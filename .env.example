# Database
DB_URL=jdbc:postgresql://postgres:5432/checkup
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# DataGSM OAuth
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
DATAGSM_REDIRECT_URI=

# DataGSM 학생 OpenAPI (학생 조회·수동 동기화·봉사 명단). DataGSM 콘솔에서 STUDENT_READ 권한으로 발급. 비어 있으면 서버가 시작하지 않는다.
DATAGSM_API_KEY=

# DataGSM 웹훅 (이벤트 등록 시 한 번만 발급)
DATAGSM_WEBHOOK_SECRET=

# 학생 웹 주소 (QR 링크에 사용)
PUBLIC_ORIGIN=

# 얼굴 AI 서버(CheckUp-AI). 둘 다 비어 있으면 서버가 시작하지 않는다.
# 서버와 AI 서버가 같은 값을 쓰는 공유 비밀값(예: openssl rand -hex 32)
FACE_SERVICE_TOKEN=
# AI 서버 주소(예: http://<AI 서버 주소>:8000)
FACE_AI_BASE_URL=

# 개발·테스트용 관리자 DataGSM 계정 id(member.datagsm_id), 쉼표 구분(예: 12,34). 비워 두면 허용 목록 없음.
# 목록 계정은 전교생 정보를 볼 수 있으므로 운영 전에는 비운다.
CHECKUP_ADMIN_DATAGSM_IDS=

# 세션
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=

# API 문서
SWAGGER_ENABLED=true

# 요청별 DB 쿼리 수·걸린 시간 로그. 느린 API를 찾을 때만 true로 둔다.
QUERY_LOG_ENABLED=false

# DB 커넥션 풀. 비워 두면 기본값(크기 10, 가득 찼을 때 10초 대기)을 쓴다.
# 서버 대수 × 풀 크기가 Postgres max_connections보다 작아야 한다.
DB_POOL_SIZE=
DB_POOL_TIMEOUT_MS=

# 서버 JVM 옵션. 비워 두면 -XX:+ExitOnOutOfMemoryError만 적용한다. 값을 넣으면 이 값으로 바뀌므로 그 옵션도 함께 쓴다.
# 예: -XX:+ExitOnOutOfMemoryError -XX:MaxRAMPercentage=50
SERVER_JAVA_OPTS=
